NODE_ENV=production
PORT=3000

# OBRIGATÓRIO em produção
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# OBRIGATÓRIO em produção — nunca alterar após primeiro uso
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPF_LOOKUP_SALT=

# URL do frontend em produção (nunca usar * em produção)
CORS_ORIGIN=https://www.validevento.com.br

DATABASE_URL=postgresql://
# Máximo de conexões no pool do PostgreSQL (default: 20)
DATABASE_POOL_MAX=20
JWT_EXPIRES_IN=24h
RESEND_API_KEY=re_xxxxxxxx
FRONTEND_URL=https://www.validevento.com.br
